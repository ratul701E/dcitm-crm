# ==============================================================================
# DCITM CRM — Docker Compose Environment Configuration
# ==============================================================================
# Copy this file to .env.docker (or .env) before running:
#   docker compose --env-file .env.docker up -d
# ==============================================================================

# Node Environment
NODE_ENV=production

# ------------------------------------------------------------------------------
# Host Port Mappings
# ------------------------------------------------------------------------------
FRONTEND_PORT=3001
BACKEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=dcitm_crm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_replace_in_prod

# ------------------------------------------------------------------------------
# Redis Cache & Queue Configuration
# ------------------------------------------------------------------------------
REDIS_PASSWORD=redis_secure_password_replace_in_prod

# ------------------------------------------------------------------------------
# Database Automated Backup Configuration (prodrigestivill/postgres-backup-local)
# ------------------------------------------------------------------------------
# Schedule format: @hourly, @daily, @weekly, @monthly, @every 6h, or cron "0 2 * * *"
BACKUP_SCHEDULE=@daily
# Retention policy (automatically removes older backups)
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

# ------------------------------------------------------------------------------
# Security & JWT Tokens
# ------------------------------------------------------------------------------
# IMPORTANT: Generate random strings for production deployments!
JWT_ACCESS_SECRET=super_secret_access_jwt_key_at_least_32_characters_long_dcitm
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_characters_long_dcitm
JWT_REFRESH_EXPIRATION=7d

# AES-256-GCM Master Key for Vault Encryption (64 hex characters = 32 bytes)
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# CORS & Network Origins
# ------------------------------------------------------------------------------
# Comma-separated allowed origins or * for open
CORS_ORIGIN=*
