# ==============================================================================
# DCITM CRM — Complete Production Environment Configuration (.env)
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# ------------------------------------------------------------------------------
# Host Port Mappings (Ports exposed on your VPS host)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3001
BACKEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# PostgreSQL Database (Local Container)
# ------------------------------------------------------------------------------
POSTGRES_DB=dcitm_crm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dcitm_secure_db_pass_2026

# Internal connection URL for the NestJS Backend Container
DATABASE_URL=postgresql://postgres:dcitm_secure_db_pass_2026@postgres:5432/dcitm_crm?schema=public

# ------------------------------------------------------------------------------
# Redis Cache & BullMQ Queue (Local Container)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=dcitm_secure_redis_pass_2026
REDIS_URL=redis://:dcitm_secure_redis_pass_2026@redis:6379

# ------------------------------------------------------------------------------
# Automated Database Backup Configuration (prodrigestivill/postgres-backup-local)
# ------------------------------------------------------------------------------
# Schedule format: @hourly, @daily, @weekly, @monthly, @every 6h, or cron "0 2 * * *"
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

# ------------------------------------------------------------------------------
# Security & JWT Authentication Tokens (64-character pre-generated keys)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=dcitm_crm_access_token_secret_key_8f3a2b1c9e4d7f0a5b8c2d1e3f6a9b0c
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=dcitm_crm_refresh_token_secret_key_7e2d1c0b9a8f5e4d3c2b1a0f9e8d7c6b
JWT_REFRESH_EXPIRATION=7d

# ------------------------------------------------------------------------------
# Cryptography & Vault (32-byte AES-256-GCM hex key = 64 hex characters)
# ------------------------------------------------------------------------------
ENCRYPTION_MASTER_KEY=4a8f9c1e2b3d5f7a0c8e6b4d2f1a3c5e7b9d0f2a4c6e8b0d1f3a5c7e9b1d3f5a

# ------------------------------------------------------------------------------
# CORS & Network Origins
# ------------------------------------------------------------------------------
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------------------------
VITE_API_URL=/api
