PORT=3000
NODE_ENV=development

# Request Payload Limit
BODY_LIMIT=10mb

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dcitm_crm?schema=public

# Redis (Queue & Caching / Throttling)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=super_secret_access_jwt_key_at_least_32_characters_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_characters_long
JWT_REFRESH_EXPIRATION=7d

# Cryptography & Vault (32-byte hex or base64 key for AES-256-GCM)
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
