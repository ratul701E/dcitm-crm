datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// Enums
// ----------------------------------------------------

enum UserRole {
  ADMIN
  MEMBER
  VIEWER
}

enum DomainStatus {
  ACTIVE
  PAUSED
  FAILED
}

enum MailboxType {
  GOOGLE
  MICROSOFT
  SMTP_IMAP
}

enum MailboxState {
  ACTIVE
  WARMING
  PAUSED
  AUTH_FAILED
}

enum LeadVerificationStatus {
  UNVERIFIED
  VALID
  RISKY
  INVALID
  DISPOSABLE
  CATCH_ALL
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  REPLIED
  BOUNCED
  SOFT_BOUNCED
  UNSUBSCRIBED
  SUPPRESSED
  COMPLETED
}

enum SuppressionReason {
  UNSUBSCRIBE
  HARD_BOUNCE
  SPAM_COMPLAINT
  MANUAL_DNC
  INVALID_EMAIL
  DISPOSABLE_EMAIL
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum DelayMode {
  FIXED
  UNIFORM_RANDOM
  WEIGHTED_RANDOM
  NATURAL
}

enum EmailDispatchStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

enum ReplyCategory {
  INTERESTED
  FOLLOW_UP_LATER
  NOT_INTERESTED
  OUT_OF_OFFICE
  UNSUBSCRIBE
  GENERAL
}

// ----------------------------------------------------
// Entities
// ----------------------------------------------------

model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  passwordHash       String
  firstName          String
  lastName           String
  role               UserRole   @default(MEMBER)
  hashedRefreshToken String?
  isActive           Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  auditLogs          AuditLog[]
  campaignsCreated   Campaign[]
  categoriesCreated  Category[]

  @@index([email])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?
  actor        User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action       String
  targetEntity String
  targetId     String?
  metadata     Json?
  ipAddress    String?
  status       String   @default("success")
  createdAt    DateTime @default(now())

  @@index([actorUserId])
  @@index([targetEntity, targetId])
  @@index([createdAt])
}

model Domain {
  id              String       @id @default(uuid())
  name            String       @unique // e.g., outreach.example.com
  dkimSelector    String       @default("google")
  status          DomainStatus @default(ACTIVE)
  redirectUrl     String?
  spfRecordPass   Boolean      @default(false)
  dkimRecordPass  Boolean      @default(false)
  dmarcRecordPass Boolean      @default(false)
  mxRecordPass    Boolean      @default(false)
  ctdCnamePass    Boolean      @default(false)
  lastDnsCheckedAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  mailboxes       Mailbox[]

  @@index([name])
}

model Mailbox {
  id                 String       @id @default(uuid())
  email              String       @unique
  domainId           String
  domain             Domain       @relation(fields: [domainId], references: [id], onDelete: Cascade)
  type               MailboxType
  state              MailboxState @default(WARMING)
  displayName        String?
  senderName         String?
  replyToEmail       String?
  lastSyncAt         DateTime?
  sentThisHour       Int          @default(0)
  hourlyLimit        Int          @default(10)
  
  // Encrypted Credentials (stored via AES-256-GCM Vault)
  encryptedConfig    Json         // { ciphertext, iv, authTag }
  
  dailySendingLimit  Int          @default(50)
  warmupDailyLimit   Int          @default(10)
  sentCountToday     Int          @default(0)
  minDelaySeconds    Int          @default(0)
  lastSentAt         DateTime?
  
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  campaignMailboxes  CampaignMailbox[]
  emailLogs          EmailLog[]
  inboundReplies     InboundReply[]
  warmupPlan         WarmupPlan?

  @@index([email])
  @@index([state])
}

model Category {
  id          String             @id @default(uuid())
  name        String
  description String?

  parentId    String?
  parent      Category?          @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]         @relation("CategoryHierarchy")

  level       Int                @default(1) // 1 = Industry, 2 = Subcategory
  sortOrder   Int                @default(0)

  createdById String?
  createdBy   User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  audienceGroups     LeadList[]         @relation("CategoryAudienceGroups")
  campaignCategories CampaignCategory[]

  @@unique([parentId, name])
  @@index([parentId, sortOrder])
  @@index([level])
}

model LeadList {
  id               String             @id @default(uuid())
  name             String
  description      String?
  isSystem         Boolean            @default(false)
  parentCategoryId String?
  parentCategory   Category?          @relation("CategoryAudienceGroups", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  sortOrder        Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  leads            Lead[]
  campaigns        CampaignLeadList[]

  @@index([parentCategoryId, sortOrder])
  @@index([name])
  @@index([isSystem])
}

model Lead {
  id                 String                 @id @default(uuid())
  leadListId         String
  leadList           LeadList               @relation(fields: [leadListId], references: [id], onDelete: Cascade)
  email              String
  firstName          String?
  lastName           String?
  company            String?
  jobTitle           String?
  website            String?
  linkedIn           String?
  city               String?
  country            String?
  customVariables    Json?                  // Flexible attributes (e.g. techStack, funding)
  leadScore          Int                    @default(50)
  tags               String[]               @default([])
  verificationStatus LeadVerificationStatus @default(UNVERIFIED)
  status             LeadStatus             @default(NEW)
  nextScheduledAt    DateTime?
  currentStepOrder   Int                    @default(1)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  deletedAt          DateTime?

  emailLogs          EmailLog[]
  inboundReplies     InboundReply[]
  campaignRecipients CampaignRecipient[]

  @@unique([leadListId, email])
  @@index([email])
  @@index([status])
  @@index([nextScheduledAt])
  @@index([deletedAt])
}

model SuppressionEntry {
  id         String            @id @default(uuid())
  value      String            @unique // Email address or wildcard domain (e.g. @domain.com)
  isWildcard Boolean           @default(false)
  reason     SuppressionReason
  source     String?           // e.g. "bounce_handler", "manual_import", "unsubscribe_link"
  notes      String?
  createdAt  DateTime          @default(now())

  @@index([value])
  @@index([isWildcard])
}

model Campaign {
  id               String           @id @default(uuid())
  title            String
  status           CampaignStatus   @default(DRAFT)
  draftStep        Int              @default(1)
  campaignType     String           @default("outreach")
  tags             String[]         @default([])
  scheduledFor     DateTime?
  replyToEmail     String?
  excludedLeadListIds String[]      @default([])
  retryOnSoftBounce Boolean         @default(true)
  unsubscribeLinkEnabled Boolean    @default(true)
  targetTimezone   String           @default("UTC")
  dailyWindowStart String           @default("09:00") // HH:mm format
  dailyWindowEnd   String           @default("17:00") // HH:mm format
  activeDays       Int[]            @default([1, 2, 3, 4, 5]) // 1 = Mon, 7 = Sun
  maxNewLeadsPerDay Int             @default(50)
  hourlyLimit      Int              @default(10)
  minDelaySeconds  Int              @default(45)
  delayMode            DelayMode        @default(WEIGHTED_RANDOM)
  minimumDelaySeconds  Int              @default(10)
  maximumDelaySeconds  Int?
  randomSeed           String?
  delaySequenceIndex   Int              @default(0)
  nextAllowedSendAt    DateTime?
  trackOpens       Boolean          @default(true)
  trackClicks      Boolean          @default(true)
  
  createdById      String?
  createdBy        User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  campaignMailboxes  CampaignMailbox[]
  campaignLeadLists  CampaignLeadList[]
  campaignCategories CampaignCategory[]
  recipients         CampaignRecipient[]
  sequences          Sequence[]
  emailLogs          EmailLog[]
  analyticsRollups   AnalyticsRollup[]

  @@index([status])
}

model CampaignMailbox {
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  mailboxId  String
  mailbox    Mailbox  @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@id([campaignId, mailboxId])
}

model CampaignLeadList {
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadListId String
  leadList   LeadList @relation(fields: [leadListId], references: [id], onDelete: Cascade)

  @@id([campaignId, leadListId])
}

model CampaignCategory {
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@id([campaignId, categoryId])
  @@index([campaignId])
  @@index([categoryId])
}

model CampaignRecipient {
  id                    String    @id @default(uuid())
  campaignId            String
  campaign              Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId                String
  lead                  Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  email                 String
  firstName             String?
  lastName              String?
  company               String?

  currentPhaseOrder     Int       @default(1)
  phaseDeliveryStatus   String    @default("PENDING")
  nextPhaseScheduledAt  DateTime?
  lastPhaseSentAt       DateTime?

  createdAt             DateTime  @default(now())

  @@unique([campaignId, leadId])
  @@index([campaignId])
  @@index([leadId])
  @@index([campaignId, currentPhaseOrder])
}

model Sequence {
  id          String         @id @default(uuid())
  campaignId  String
  campaign    Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title       String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  steps       SequenceStep[]
}

model SequenceStep {
  id          String            @id @default(uuid())
  sequenceId  String
  sequence    Sequence          @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  title       String            @default("")
  stepOrder   Int               // 1, 2, 3...
  delayDays   Int               @default(3)
  delayHours  Int               @default(0)
  scheduledAt DateTime?
  status      String            @default("ACTIVE")
  isArchived  Boolean           @default(false)
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  variants    SequenceVariant[]
  emailLogs   EmailLog[]

  @@unique([sequenceId, stepOrder])
  @@index([sequenceId, isArchived])
}

model SequenceVariant {
  id             String       @id @default(uuid())
  sequenceStepId String
  sequenceStep   SequenceStep @relation(fields: [sequenceStepId], references: [id], onDelete: Cascade)
  variantKey     String       // e.g. "A", "B"
  weight         Int          @default(50) // Percentage weight distribution
  subject        String       // Supports Spintax
  body           String       // HTML / text with Spintax & variables
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  emailLogs      EmailLog[]
}

model EmailLog {
  id                 String              @id @default(uuid())
  messageId          String?             @unique // RFC 2822 Message-ID
  campaignId         String
  campaign           Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sequenceStepId     String?
  sequenceStep       SequenceStep?       @relation(fields: [sequenceStepId], references: [id], onDelete: SetNull)
  sequenceVariantId  String?
  sequenceVariant    SequenceVariant?    @relation(fields: [sequenceVariantId], references: [id], onDelete: SetNull)
  phaseOrderSnapshot Int?
  phaseTitleSnapshot String?
  mailboxId          String
  mailbox            Mailbox             @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  leadId             String
  lead               Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  status             EmailDispatchStatus @default(PENDING)
  openedAt           DateTime?
  openCount          Int                 @default(0)
  clickedAt          DateTime?
  clickCount         Int                 @default(0)
  bounceReason       String?
  retryCount         Int                 @default(0)
  sentAt             DateTime?
  createdAt          DateTime            @default(now())

  inboundReplies     InboundReply[]

  @@index([messageId])
  @@index([campaignId])
  @@index([mailboxId])
  @@index([leadId])
  @@index([status])
  @@index([campaignId, sequenceStepId])
}

model InboundReply {
  id           String         @id @default(uuid())
  emailLogId   String?
  emailLog     EmailLog?      @relation(fields: [emailLogId], references: [id], onDelete: SetNull)
  mailboxId    String
  mailbox      Mailbox        @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  leadId       String
  lead         Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  fromEmail    String
  toEmail      String
  subject      String
  bodyText     String?
  bodyHtml     String?
  category     ReplyCategory  @default(GENERAL)
  isRead       Boolean        @default(false)
  isStarred    Boolean        @default(false)
  status       String         @default("active")
  receivedAt   DateTime       @default(now())
  createdAt    DateTime       @default(now())

  @@index([mailboxId])
  @@index([leadId])
  @@index([category])
}

model AnalyticsRollup {
  id             String    @id @default(uuid())
  campaignId     String
  campaign       Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  date           DateTime  @db.Date
  sentCount      Int       @default(0)
  deliveredCount Int       @default(0)
  openCount      Int       @default(0)
  clickCount     Int       @default(0)
  replyCount     Int       @default(0)
  bounceCount    Int       @default(0)
  hardBounceCount Int      @default(0)
  softBounceCount Int      @default(0)
  unsubscribeCount Int     @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([campaignId, date])
  @@index([campaignId])
  @@index([date])
}

model WarmupPlan {
  id                 String    @id @default(uuid())
  mailboxId          String    @unique
  mailbox            Mailbox   @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  currentDailyLimit  Int       @default(10)
  targetDailyLimit   Int       @default(50)
  rampUpStep         Int       @default(5)
  replyRatePercent   Int       @default(30)
  status             String    @default("active")
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([mailboxId])
}

model EmailTemplate {
  id          String   @id @default(uuid())
  name        String
  subject     String
  body        String             // legacy plain-text fallback
  htmlContent String?            // rendered email-safe HTML (cached from renderer)
  designJson  Json?              // canonical visual builder JSON (source of truth)
  description String?
  previewText String?
  category    String   @default("general")
  variables   String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model Segment {
  id          String   @id @default(uuid())
  name        String
  description String?
  conditions  Json
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

